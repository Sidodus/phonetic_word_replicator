{
  "name": "phonetic-word-replicator",
  "version": "2.0.0",
  "description": "Phonetic Word Replicator — learn spelling through IPA / X-SAMPA phonetic sounds. Modern v2 rewrite: Next.js + TypeScript + React-Bootstrap.",
  "private": true,
  "author": "Saheed Odulaja <https://github.com/Sidodus>",
  "license": "MIT",
  "homepage": "https://sidodus.github.io/phonetic_word_replicator/",
  "repository": {
    "type": "git",
    "url": "https://github.com/Sidodus/phonetic_word_replicator"
  },
  "engines": {
    "node": ">=18.18.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:pages": "node scripts/build-pages.mjs",
    "start": "serve out -l 4173",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "data:curate": "node scripts/curate-dictionary.mjs",
    "data:validate": "node scripts/curate-dictionary.mjs --validate",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run data:validate && npm run build"
  },
  "dependencies": {
    "bootstrap": "^5.3.8",
    "next": "^15.5.0",
    "react": "^19.1.0",
    "react-bootstrap": "^2.10.10",
    "react-dom": "^19.1.0",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@playwright/test": "^1.54.0",
    "@testing-library/jest-dom": "^6.6.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "@vitest/coverage-v8": "^3.2.0",
    "eslint": "^9.30.0",
    "eslint-config-next": "^15.5.0",
    "jsdom": "^26.1.0",
    "serve": "^14.2.4",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
